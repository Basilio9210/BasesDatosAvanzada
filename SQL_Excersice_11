-- =====================================================================
-- 3. EJERCICIOS (de fácil a un poco más difícil)
-- =====================================================================

-- ---------------------------------------------------------------------
-- NIVEL 1: SELECT, WHERE, ORDER BY, LIMIT
-- ---------------------------------------------------------------------

-- 1.1 Ver todos los pacientes
SELECT * FROM patients;

-- 1.2 Solo nombre, apellido y ciudad
SELECT first_name, last_name, city FROM patients;

-- 1.3 Pacientes mujeres
SELECT first_name, last_name, gender
FROM patients
WHERE gender = 'F';

-- 1.4 Pacientes de Toronto o Montreal
SELECT first_name, last_name, city
FROM patients
WHERE city IN ('Toronto', 'Montreal');

-- 1.5 Pacientes con peso entre 60 y 80 kg
SELECT first_name, last_name, weight
FROM patients
WHERE weight BETWEEN 60 AND 80;

-- 1.6 Pacientes cuyo apellido empieza con 'M'
SELECT first_name, last_name
FROM patients
WHERE last_name LIKE 'M%';

-- 1.7 Pacientes SIN alergias (NULL se compara con IS NULL, nunca con = NULL)
SELECT first_name, last_name
FROM patients
WHERE allergies IS NULL;

-- 1.8 Los 5 pacientes más pesados
SELECT first_name, last_name, weight
FROM patients
ORDER BY weight DESC
LIMIT 5;                   -- SQL Server: SELECT TOP 5 ...

-- ---------------------------------------------------------------------
-- NIVEL 2: Funciones de agregación (COUNT, SUM, AVG, MIN, MAX)
-- ---------------------------------------------------------------------

-- 2.1 Cuántos pacientes hay
SELECT COUNT(*) AS total_pacientes FROM patients;

-- 2.2 Peso promedio, mínimo y máximo
SELECT
    AVG(weight) AS peso_promedio,
    MIN(weight) AS peso_minimo,
    MAX(weight) AS peso_maximo
FROM patients;

-- 2.3 Suma del peso de todos los pacientes
SELECT SUM(weight) AS peso_total FROM patients;

-- 2.4 COUNT(*) vs COUNT(columna): COUNT(columna) ignora los NULL
SELECT
    COUNT(*)         AS total,
    COUNT(allergies) AS con_alergias
FROM patients;

-- 2.5 Número de ciudades distintas
SELECT COUNT(DISTINCT city) AS ciudades_distintas FROM patients;

-- ---------------------------------------------------------------------
-- NIVEL 3: GROUP BY y HAVING
-- ---------------------------------------------------------------------

-- 3.1 Cuántos pacientes hay por género
SELECT gender, COUNT(*) AS total
FROM patients
GROUP BY gender;

-- 3.2 Cuántos pacientes hay por ciudad (de mayor a menor)
SELECT city, COUNT(*) AS total
FROM patients
GROUP BY city
ORDER BY total DESC;

-- 3.3 Peso promedio por género
SELECT gender, ROUND(AVG(weight), 1) AS peso_promedio
FROM patients
GROUP BY gender;

-- 3.4 Ciudades con 2 o más pacientes
--     WHERE filtra FILAS (antes de agrupar), HAVING filtra GRUPOS (después)
SELECT city, COUNT(*) AS total
FROM patients
GROUP BY city
HAVING COUNT(*) >= 2;

-- 3.5 Número de admisiones por diagnóstico
SELECT diagnosis, COUNT(*) AS total_admisiones
FROM admissions
GROUP BY diagnosis
ORDER BY total_admisiones DESC;

-- 3.6 Número de admisiones por doctor (solo ID)
SELECT attending_doctor_id, COUNT(*) AS total
FROM admissions
GROUP BY attending_doctor_id;

-- ---------------------------------------------------------------------
-- NIVEL 4: INNER JOIN
-- ---------------------------------------------------------------------

-- 4.1 Pacientes con el nombre de su provincia
SELECT p.first_name, p.last_name, pn.province_name
FROM patients p
INNER JOIN province_names pn ON p.province_id = pn.province_id;

-- 4.2 Admisiones con nombre del paciente y diagnóstico
SELECT p.first_name, p.last_name, a.admission_date, a.diagnosis
FROM admissions a
INNER JOIN patients p ON a.patient_id = p.patient_id
ORDER BY a.admission_date;

-- 4.3 Admisiones con paciente Y doctor (3 tablas)
SELECT
    p.first_name || ' ' || p.last_name AS paciente,   -- MySQL: CONCAT(p.first_name, ' ', p.last_name)
    d.last_name                        AS doctor,
    d.specialty,
    a.diagnosis
FROM admissions a
INNER JOIN patients p ON a.patient_id = p.patient_id
INNER JOIN doctors  d ON a.attending_doctor_id = d.doctor_id;

-- 4.4 Número de pacientes por provincia (con nombre de la provincia)
SELECT pn.province_name, COUNT(*) AS total_pacientes
FROM patients p
INNER JOIN province_names pn ON p.province_id = pn.province_id
GROUP BY pn.province_name
ORDER BY total_pacientes DESC;

-- 4.5 Número de admisiones por doctor (con nombre)
SELECT d.first_name, d.last_name, d.specialty, COUNT(*) AS total_admisiones
FROM admissions a
INNER JOIN doctors d ON a.attending_doctor_id = d.doctor_id
GROUP BY d.doctor_id, d.first_name, d.last_name, d.specialty
ORDER BY total_admisiones DESC;

-- 4.6 Admisiones por especialidad
SELECT d.specialty, COUNT(*) AS total_admisiones
FROM admissions a
INNER JOIN doctors d ON a.attending_doctor_id = d.doctor_id
GROUP BY d.specialty;

-- ---------------------------------------------------------------------
-- NIVEL 5: LEFT JOIN, NOT IN, IN, NOT EXISTS
-- ---------------------------------------------------------------------

-- 5.1 Todas las provincias, incluso las que no tienen pacientes (LEFT JOIN)
SELECT pn.province_name, COUNT(p.patient_id) AS total_pacientes
FROM province_names pn
LEFT JOIN patients p ON pn.province_id = p.province_id
GROUP BY pn.province_name
ORDER BY total_pacientes DESC;

-- 5.2 Pacientes que NUNCA han sido admitidos (NOT IN)
SELECT patient_id, first_name, last_name
FROM patients
WHERE patient_id NOT IN (SELECT patient_id FROM admissions);

-- 5.3 Lo mismo con LEFT JOIN + IS NULL
SELECT p.patient_id, p.first_name, p.last_name
FROM patients p
LEFT JOIN admissions a ON p.patient_id = a.patient_id
WHERE a.patient_id IS NULL;

-- 5.4 Lo mismo con NOT EXISTS
SELECT p.patient_id, p.first_name, p.last_name
FROM patients p
WHERE NOT EXISTS (
    SELECT 1 FROM admissions a WHERE a.patient_id = p.patient_id
);

-- 5.5 Doctores que NO han atendido ninguna admisión
SELECT doctor_id, first_name, last_name, specialty
FROM doctors
WHERE doctor_id NOT IN (
    SELECT attending_doctor_id FROM admissions
    WHERE attending_doctor_id IS NOT NULL   -- ¡cuidado! un NULL dentro de NOT IN rompe el resultado
);

-- 5.6 Pacientes que han sido admitidos por diagnóstico 'Stroke' o 'Heart Failure' (IN)
SELECT DISTINCT p.first_name, p.last_name, a.diagnosis
FROM patients p
INNER JOIN admissions a ON p.patient_id = a.patient_id
WHERE a.diagnosis IN ('Stroke', 'Heart Failure');

-- 5.7 Provincias que no tienen ningún paciente
SELECT province_name
FROM province_names
WHERE province_id NOT IN (SELECT DISTINCT province_id FROM patients);

-- ---------------------------------------------------------------------
-- NIVEL 6: GROUP BY + JOIN + HAVING (combinando todo)
-- ---------------------------------------------------------------------

-- 6.1 Pacientes con más de 1 admisión
SELECT p.first_name, p.last_name, COUNT(*) AS total_admisiones
FROM patients p
INNER JOIN admissions a ON p.patient_id = a.patient_id
GROUP BY p.patient_id, p.first_name, p.last_name
HAVING COUNT(*) > 1
ORDER BY total_admisiones DESC;

-- 6.2 Peso promedio de pacientes por provincia, solo provincias con promedio > 70
SELECT pn.province_name, ROUND(AVG(p.weight), 1) AS peso_promedio
FROM patients p
INNER JOIN province_names pn ON p.province_id = pn.province_id
GROUP BY pn.province_name
HAVING AVG(p.weight) > 70;

-- 6.3 Doctores con más de 3 admisiones
SELECT d.first_name, d.last_name, COUNT(*) AS total
FROM admissions a
INNER JOIN doctors d ON a.attending_doctor_id = d.doctor_id
GROUP BY d.doctor_id, d.first_name, d.last_name
HAVING COUNT(*) > 3;

-- 6.4 Diagnóstico más común
SELECT diagnosis, COUNT(*) AS total
FROM admissions
GROUP BY diagnosis
ORDER BY total DESC
LIMIT 1;

-- ---------------------------------------------------------------------
-- NIVEL 7: Subconsultas, CASE y fechas
-- ---------------------------------------------------------------------

-- 7.1 Pacientes con peso mayor al promedio general
SELECT first_name, last_name, weight
FROM patients
WHERE weight > (SELECT AVG(weight) FROM patients)
ORDER BY weight DESC;

-- 7.2 Clasificar pacientes por IMC (peso / altura en metros al cuadrado) con CASE
SELECT
    first_name,
    last_name,
    ROUND(weight / ((height / 100.0) * (height / 100.0)), 1) AS imc,
    CASE
        WHEN weight / ((height / 100.0) * (height / 100.0)) < 18.5 THEN 'Bajo peso'
        WHEN weight / ((height / 100.0) * (height / 100.0)) < 25   THEN 'Normal'
        WHEN weight / ((height / 100.0) * (height / 100.0)) < 30   THEN 'Sobrepeso'
        ELSE 'Obesidad'
    END AS categoria
FROM patients;

-- 7.3 Admisiones aún abiertas (sin fecha de alta)
SELECT p.first_name, p.last_name, a.admission_date
FROM admissions a
INNER JOIN patients p ON a.patient_id = p.patient_id
WHERE a.discharge_date IS NULL;

-- 7.4 Días de estancia por admisión
--     PostgreSQL:  a.discharge_date - a.admission_date
--     SQLite:      julianday(a.discharge_date) - julianday(a.admission_date)
--     MySQL:       DATEDIFF(a.discharge_date, a.admission_date)
SELECT
    p.first_name,
    p.last_name,
    a.diagnosis,
    julianday(a.discharge_date) - julianday(a.admission_date) AS dias_estancia   -- versión SQLite
FROM admissions a
INNER JOIN patients p ON a.patient_id = p.patient_id
WHERE a.discharge_date IS NOT NULL
ORDER BY dias_estancia DESC;

-- 7.5 Admisiones por año
--     SQLite: strftime('%Y', admission_date) | PostgreSQL/MySQL: EXTRACT(YEAR FROM admission_date)
SELECT strftime('%Y', admission_date) AS anio, COUNT(*) AS total
FROM admissions
GROUP BY anio;

-- 7.6 Edad actual de cada paciente (SQLite)
SELECT
    first_name,
    last_name,
    CAST((julianday('now') - julianday(birth_date)) / 365.25 AS INTEGER) AS edad
FROM patients
ORDER BY edad DESC;

-- 7.7 Pacientes con alergia a la penicilina que han sido admitidos
SELECT DISTINCT p.first_name, p.last_name, p.allergies
FROM patients p
INNER JOIN admissions a ON p.patient_id = a.patient_id
WHERE p.allergies = 'Penicillin';

